# Konfiguration für docker compose (Kopie als .env anlegen; .env NICHT committen).

# Port, auf dem der Frontend-Container (Nginx) auf dem LXC-Host lauscht.
# NPM zeigt auf http://<LXC-IP>:<WEB_PORT>
# Standard: 8080 (ändere ihn, falls der Port bereits belegt ist).
WEB_PORT=8080

# Bind-Adresse auf der Docker-VM. 0.0.0.0 ist nötig, wenn Nginx Proxy Manager
# aus einer anderen VM im LAN zugreift. Den Port per Firewall nur fürs LAN/NPM
# freigeben.
BIND_ADDRESS=0.0.0.0

# Name des Sitzungs-Cookies (muss nicht geändert werden).
SESSION_COOKIE_NAME=ap_session

# Komma-Liste der Admin-E-Mails (sehen in der App Konto → Admin-Bereich:
# Konten sperren/löschen, Einladungen erzeugen). Leer = kein Admin.
ADMIN_EMAILS=

# Wer darf Konten anlegen? open | invite | closed (s. DEPLOYMENT.md)
# Standard seit C9: invite (Konten nur per Einladungscode).
REGISTRATION=invite

# Nutzung nur mit Konto (true/false). true: ohne Sitzung zeigt die App nur die
# Konto-Seite (Login/Registrierung mit Einladung), Prüfungsinhalte liefert nginx
# nur mit gültiger Sitzung aus. Standard: true.
REQUIRE_LOGIN=true
