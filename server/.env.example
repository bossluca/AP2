# Backend-Konfiguration (Kopie als .env anlegen; .env NIE committen)

# Port und Host des HTTP-Servers
PORT=3001
HOST=0.0.0.0

# Pfad zur SQLite-Datei (wird bei Bedarf angelegt). In Docker auf ein Volume legen.
DB_PATH=./data/lernapp.sqlite

# Name des Sitzungs-Cookies
SESSION_COOKIE_NAME=ap_session

# Erlaubter Frontend-Origin für CORS (nur nötig, wenn Frontend auf anderer
# Origin läuft, z. B. im Dev: http://localhost:5173). In Produktion meist leer,
# da Frontend und API über denselben Reverse-Proxy/Origin laufen.
CORS_ORIGIN=

# In Produktion auf "production" setzen -> Secure-Flag für Cookies (nur HTTPS)
NODE_ENV=development

# Hinter einem Reverse-Proxy (Nginx/Caddy) X-Forwarded-For vertrauen, damit das
# Login-Rate-Limit pro echter Client-IP greift (Standard: an). Bei direktem
# Betrieb ohne Proxy auf 0 setzen.
TRUST_PROXY=1

# Wer darf Konten anlegen?
#   open   = jede/r (Standard ohne Angabe, abwärtskompatibel)
#   invite = nur mit Einladungs-Code (erzeugt im Admin-Bereich /#/admin)
#   closed = keine neuen Konten
# Tipp: gleich mit "invite" starten und den ersten Code auf dem Server erzeugen:
#   docker compose exec backend node src/einladung-cli.js "Admin-Konto"
REGISTRATION=open

# Nutzung nur mit Konto (Login-Pflicht, C9): true → GET /api/auth/config meldet
# loginPflicht, das Frontend zeigt ohne Sitzung nur die Konto-Seite.
# Ohne Angabe: false (lokale Entwicklung/Tests unverändert). docker-compose.yml
# setzt standardmäßig REQUIRE_LOGIN=true.
REQUIRE_LOGIN=true

# Komma-Liste der Admin-E-Mails (Admin-Bereich: Konten sperren/löschen,
# Einladungen erzeugen). Leer = kein Admin.
ADMIN_EMAILS=
